# Shared Ghostty config for all hosts.
# OS-specific settings live in config.macos / config.linux; sync.sh links the
# right one to config.local, which is loaded at the end of this file.

# Start herdr (attaches to the running session) in every new window
#command = /bin/zsh -lc herdr

# Font
font-family = JetBrains Mono
font-size = 14

# Colors (theme in themes/WaveVivid, converted from Wave Terminal)
theme = WaveVivid

config-file = ?config.local
